meta {
  name: Fotos de otros usuarios
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/photos?page=1&per_page=10
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

docs {
  Solo muestra fotos de otros usuarios visibles. No cambia photoId: ese lo
  asigna "Crear foto de otro usuario".
}
