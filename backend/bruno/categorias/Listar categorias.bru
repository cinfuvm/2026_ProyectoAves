meta {
  name: Listar categorias
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/categories
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  if (res.body.categories && res.body.categories.length > 0) {
    bru.setVar("categoryId", res.body.categories[0].id);
  }
}

assert {
  res.status: eq 200
}
