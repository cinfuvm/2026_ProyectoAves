meta {
  name: Cerrar sesion
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/api/user/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 204
}

docs {
  Revoca el token del usuario. Ejecutar al final: después de esto el token
  deja de funcionar y hay que volver a hacer "Login usuario".
}
