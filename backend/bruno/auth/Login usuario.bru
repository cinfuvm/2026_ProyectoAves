meta {
  name: Login usuario
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/user/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("token", res.body.token);
}

assert {
  res.status: eq 200
}
