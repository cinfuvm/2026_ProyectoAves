meta {
  name: Buscar aves por categoria
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/birds?category_id={{categoryId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

assert {
  res.status: eq 200
}

docs {
  Requiere haber ejecutado antes "Listar categorias" para tener categoryId.
  Un valor que no sea UUID responde 422.
}
